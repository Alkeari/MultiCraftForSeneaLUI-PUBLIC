<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MultiCraftForSeneaLUI</AssemblyName>
    <RootNamespace>MultiCraftForSeneaLUI</RootNamespace>
    <Version>1.0.3</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ValheimGameDir Condition="'$(ValheimGameDir)' == ''">$(VALHEIM_GAME_DIR)</ValheimGameDir>
    <ValheimProfilesDir Condition="'$(ValheimProfilesDir)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\Valheim\profiles</ValheimProfilesDir>
    <ValheimProfileDir Condition="'$(ValheimProfileDir)' == ''">$(ValheimProfilesDir)\Default</ValheimProfileDir>
    <ValheimManaged>$(ValheimGameDir)\valheim_Data\Managed</ValheimManaged>
    <BepInExDir>$(ValheimProfileDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)\assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)\assembly_utils.dll" Private="false" Publicize="true" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManaged)\assembly_guiutils.dll" Private="false" Publicize="true" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ValheimManaged)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ValheimManaged)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="MultiCraft" HintPath="$(BepInExDir)\plugins\MaxiMods-MultiCraft\MultiCraft.dll" Private="false" Publicize="true" />
  </ItemGroup>

  <!-- SeneaL UI moves between install folders across mod managers and releases, so the newest copy anywhere under the profiles or the game is referenced. -->
  <UsingTask TaskName="PickNewestFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Newest ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Newest = Files.Select(f => f.GetMetadata("FullPath")).OrderByDescending(File.GetLastWriteTimeUtc).FirstOrDefault() ?? "";
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ReferenceSeneaLUI" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <SeneaLUICandidate Include="$(ValheimProfilesDir)\**\SeneaL-UI.dll;$(ValheimGameDir)\**\SeneaL-UI.dll" />
    </ItemGroup>
    <Error Condition="'@(SeneaLUICandidate)' == ''" Text="SeneaL-UI.dll was not found under $(ValheimProfilesDir) or $(ValheimGameDir)." />
    <PickNewestFile Files="@(SeneaLUICandidate)">
      <Output TaskParameter="Newest" PropertyName="SeneaLUIDll" />
    </PickNewestFile>
    <Message Importance="high" Text="SeneaL-UI.dll: $(SeneaLUIDll)" />
    <ItemGroup>
      <Reference Include="SeneaL-UI" HintPath="$(SeneaLUIDll)" Private="false" Publicize="true" />
    </ItemGroup>
  </Target>

  <Target Name="WritePluginVersion" BeforeTargets="BeforeCompile;CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)PluginVersion.g.cs" Lines="namespace MultiCraftForSeneaLUI { internal static class PluginVersion { public const string Value = &quot;$(Version)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PluginVersion.g.cs" />
    </ItemGroup>
  </Target>

</Project>
